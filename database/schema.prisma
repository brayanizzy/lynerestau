generator client {
  provider     = "prisma-client"
  output       = "../services/api/src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

model User {
  id                 String     @id @default(cuid()) @db.VarChar(30)
  username           String     @unique @db.VarChar(100)
  email              String?    @unique @db.VarChar(191)
  displayName        String     @map("display_name") @db.VarChar(150)
  passwordHash       String     @map("password_hash") @db.VarChar(255)
  isActive           Boolean    @default(true) @map("is_active")
  mustChangePassword Boolean    @default(true) @map("must_change_password")
  authVersion        Int        @default(1) @map("auth_version")
  version            Int        @default(1)
  roleId             String     @map("role_id") @db.VarChar(30)
  createdAt          DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.DateTime(3)
  role               Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions           Session[]
  auditLogs          AuditLog[]
  employee           Employee?

  @@index([roleId])
  @@map("users")
}

model Role {
  id          String           @id @default(cuid()) @db.VarChar(30)
  code        String           @unique @db.VarChar(50)
  name        String           @db.VarChar(100)
  version     Int              @default(1)
  createdAt   DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Department {
  id        String     @id @default(cuid()) @db.VarChar(30)
  name      String     @unique @db.VarChar(100)
  isActive  Boolean    @default(true) @map("is_active")
  version   Int        @default(1)
  createdAt DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.DateTime(3)
  employees Employee[]

  @@map("departments")
}

model JobTitle {
  id        String     @id @default(cuid()) @db.VarChar(30)
  name      String     @unique @db.VarChar(100)
  isActive  Boolean    @default(true) @map("is_active")
  version   Int        @default(1)
  createdAt DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.DateTime(3)
  employees Employee[]

  @@map("job_titles")
}

model Employee {
  id            String      @id @default(cuid()) @db.VarChar(30)
  staffNumber   String      @unique @map("staff_number") @db.VarChar(30)
  fullName      String      @map("full_name") @db.VarChar(150)
  gender        String?     @db.VarChar(20)
  phone         String?     @db.VarChar(40)
  address       String?     @db.VarChar(500)
  hiredAt       DateTime?   @map("hired_at") @db.Date
  status        String      @default("ACTIVE") @db.VarChar(20)
  salary        Decimal?    @db.Decimal(12, 2)
  notes         String?     @db.VarChar(2000)
  photoKey      String?     @map("photo_key") @db.VarChar(50)
  archivedAt    DateTime?   @map("archived_at") @db.DateTime(3)
  archiveReason String?     @map("archive_reason") @db.VarChar(500)
  version       Int         @default(1)
  departmentId  String?     @map("department_id") @db.VarChar(30)
  jobTitleId    String?     @map("job_title_id") @db.VarChar(30)
  userId        String?     @unique @map("user_id") @db.VarChar(30)
  createdAt     DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.DateTime(3)
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  jobTitle      JobTitle?   @relation(fields: [jobTitleId], references: [id], onDelete: Restrict)
  user          User?       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([archivedAt, fullName, id])
  @@index([status])
  @@index([departmentId])
  @@index([jobTitleId])
  @@map("employees")
}

model Permission {
  id        String           @id @default(cuid()) @db.VarChar(30)
  code      String           @unique @db.VarChar(100)
  name      String           @db.VarChar(150)
  createdAt DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  roles     RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.VarChar(30)
  permissionId String     @map("permission_id") @db.VarChar(30)
  createdAt    DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Session {
  id          String    @id @default(cuid()) @db.VarChar(30)
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  userId      String    @map("user_id") @db.VarChar(30)
  authVersion Int       @map("auth_version")
  expiresAt   DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt   DateTime? @map("revoked_at") @db.DateTime(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditLog {
  id        String   @id @default(cuid()) @db.VarChar(30)
  userId    String?  @map("user_id") @db.VarChar(30)
  action    String   @db.VarChar(80)
  module    String   @db.VarChar(50)
  objectId  String?  @map("object_id") @db.VarChar(100)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([createdAt, id])
  @@index([userId, createdAt])
  @@map("audit_logs")
}
