{
  "name": "lyne-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API REST LYNE RESTAURANT — Fastify + TypeScript.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.tests.json --noEmit",
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=.env dist/index.js",
    "db:seed-secret": "node scripts/create-seed-secret.mjs",
    "db:seed": "tsx --env-file-if-exists=../../.env --env-file-if-exists=.env --env-file-if-exists=.env.seed src/seed.ts",
    "db:verify": "tsx --env-file-if-exists=../../.env --env-file-if-exists=.env --env-file-if-exists=.env.seed scripts/verify-database.ts",
    "db:reset-admin": "tsx --env-file-if-exists=../../.env --env-file-if-exists=.env src/reset-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.4",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@lyne/shared": "^0.1.0",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
