# services/api — variables d'environnement
# (sous-ensemble du .env.example racine, propre au service)
NODE_ENV=development

API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
API_LOG_LEVEL=info

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=lyne
DB_PASSWORD=change_me
DB_NAME=lyne_restaurant
# DATABASE_URL=mysql://lyne:change_me@127.0.0.1:3306/lyne_restaurant

SESSION_TTL_HOURS=8
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000

CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
# ADMIN_WEB_DIST=../../apps/admin-web/dist

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_TYPES=png,jpg,jpeg,pdf

PRINT_TICKET_WIDTH_MM=80
# Photos du personnel : dossier privé, hors de public_html sur le serveur.
UPLOADS_DIR=../../.tmp/private-photos
