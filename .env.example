# =============================================================================
# LYNE RESTAURANT — Variables d'environnement (modèle)
# =============================================================================
# Référence globale. Copier de préférence les exemples propres à chaque service
# en `.env` dans ce service (voir README). L'API accepte aussi un `.env` racine
# comme valeurs de repli ; Vite et Expo utilisent leur propre dossier.
# NE JAMAIS committer un `.env` réel (cf. spec §10).
#
# Convention :
#   API_*    → services/api
#   VITE_*   → apps/admin-web (exposé au navigateur par Vite)
#   EXPO_*   → apps/mobile (exposé au client par Expo/Metro)
#   DB_*     → connexion MySQL (utilisée par l'API / Prisma)
# =============================================================================

# ---------------------------------------------------------------------------
# Général
# ---------------------------------------------------------------------------
NODE_ENV=development

# ---------------------------------------------------------------------------
# Identité du restaurant (spec §4.13 / §15 — données à confirmer avec le client)
# ---------------------------------------------------------------------------
LYNE_RESTAURANT_NAME="LYNE RESTAURANT"
LYNE_RESTAURANT_ADDRESS=""
LYNE_RESTAURANT_PHONE=""
LYNE_CURRENCY=USD
LYNE_TICKET_FOOTER="Merci de votre visite — LYNE RESTAURANT"

# ---------------------------------------------------------------------------
# Base de données MySQL 8+ (utilisée dès la Phase 1)
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=lyne
DB_PASSWORD=change_me
DB_NAME=lyne_restaurant
# Alternative aux DB_* ; ne pas activer simultanément des valeurs divergentes.
# DATABASE_URL=mysql://lyne:change_me@127.0.0.1:3306/lyne_restaurant

# ---------------------------------------------------------------------------
# API — services/api
# ---------------------------------------------------------------------------
# Adresse d'écoute du serveur HTTP (0.0.0.0 en conteneur).
API_HOST=0.0.0.0
API_PORT=4000
# URL publique de l'API (utilisée par les clients).
API_PUBLIC_URL=http://localhost:4000
API_LOG_LEVEL=info

# --- Authentification (identifiants Phase 1) ---
# Jetons opaques révocables : seul leur SHA256 est stocké, pas de JWT.
SESSION_TTL_HOURS=8
# Seed uniquement : secret initial fort, changement obligatoire, jamais écrasé au re-seed.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
# Rate limiting sur les routes sensibles (/api/v1/auth, etc.).
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000

# --- CORS (origines autorisées, séparées par des virgules) ---
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
# Optionnel : servir le build web depuis l’API sous /gestion/.
# ADMIN_WEB_DIST=../../apps/admin-web/dist

# --- Fichiers / justificatifs (photos, logos, factures) ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_TYPES=png,jpg,jpeg,pdf

# --- Impression ticket (matériel à confirmer, spec §15) ---
PRINT_TICKET_WIDTH_MM=80

# ---------------------------------------------------------------------------
# Web Admin — apps/admin-web
# ---------------------------------------------------------------------------
# URL de l'API appelée depuis le navigateur (préfixe VITE_ obligatoire).
VITE_API_URL=

# ---------------------------------------------------------------------------
# Mobile — apps/mobile
# ---------------------------------------------------------------------------
# URL de l'API appelée depuis l'appareil (préfixe EXPO_PUBLIC_ obligatoire).
EXPO_PUBLIC_API_URL=http://localhost:4000
