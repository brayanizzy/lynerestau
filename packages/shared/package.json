{
  "name": "@lyne/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Types partagés, constantes et schémas Zod (à consommer par l'API, l'admin-web et le mobile).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
