# Résilience réseau pour les environnements à connectivité variable
# (surtout nécessaire pour l'arbre Expo/React Native, très volumineux).
fetch-retries=12
fetch-retry-mintimeout=5000
fetch-retry-maxtimeout=60000
fetch-timeout=300000
fetch-retry-factor=2
maxsockets=1

# Vérification des dépendances à chaque installation.
audit=true
fund=false

# npm 11.16 ignore les overrides à travers les workspaces. Respecter engines.
engine-strict=true

# Autoriser les plages de versions dans les manifestes ; npm ci utilise le lockfile.
save-exact=false
